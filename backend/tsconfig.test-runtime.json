{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/worker-env.d.ts",
    "vitest.config.ts",
    "test-runtime/**/*.ts"
  ]
}
