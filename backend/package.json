{
  "name": "backend",
  "version": "1.3.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --ip 0.0.0.0 --port 8080",
    "build": "tsc -p tsconfig.build.json",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "contracts:generate": "tsx tooling/contracts/generate-openapi.ts && openapi-typescript openapi/v2.json -o ../frontend/src/api/generated/v2-schema.d.ts",
    "wrangler:render-config": "tsx tooling/wrangler/render-production-config.ts",
    "lint": "eslint src tooling --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
