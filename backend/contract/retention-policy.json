{
  "formatVersion": 1,
  "policyVersion": "2026-08-09",
  "archive": {
    "contractSqlExportRequired": true,
    "containsSensitiveData": true,
    "artifactUploadAllowed": false,
    "storageRequirement": "encrypted-access-controlled-storage",
    "checksum": "sha256",
    "minimumDays": 400,
    "deletionRequiresBookmark": true
  },
  "datasets": [
    { "tables": ["agent_report_samples"], "retentionDays": 30, "env": "AGENT_RAW_SAMPLE_RETENTION_DAYS", "archiveBinding": "RAW_SAMPLE_ARCHIVE", "deleteRule": "delete-flag-and-source-before-cutoff-and-member-batch-r2-sha256-size-head-verified" },
    { "tables": ["monitor_check_samples"], "retentionDays": 90, "env": "MONITOR_RAW_SAMPLE_RETENTION_DAYS", "archiveBinding": "RAW_SAMPLE_ARCHIVE", "deleteRule": "delete-flag-and-source-before-cutoff-and-member-batch-r2-sha256-size-head-verified" },
    { "tables": ["raw_sample_archive_batches", "raw_sample_archive_members"], "retention": "indefinite", "deleteRule": "none" },
    { "tables": ["agent_metric_rollups"], "retentionDays": 30, "env": "AGENT_ROLLUP_RETENTION_DAYS", "deleteRule": "bucket_start-before-cutoff" },
    { "tables": ["monitor_check_rollups"], "retentionDays": 90, "env": "MONITOR_ROLLUP_RETENTION_DAYS", "deleteRule": "sub-daily-bucket-before-cutoff" },
    { "tables": ["monitor_check_rollups"], "retentionDays": 3650, "env": "MONITOR_DAILY_ROLLUP_RETENTION_DAYS", "deleteRule": "daily-bucket-before-cutoff" },
    { "tables": ["monitor_incidents"], "retentionDays": 180, "env": "MONITOR_INCIDENT_RETENTION_DAYS", "deleteRule": "closed-incident-before-cutoff" },
    { "tables": ["notification_events", "notification_messages", "notification_attempts"], "retentionDays": 90, "env": "NOTIFICATION_EVENT_RETENTION_DAYS", "deleteRule": "completed-event-before-cutoff-cascade" },
    { "tables": ["security_audit_events"], "retentionDays": 180, "env": "SECURITY_AUDIT_RETENTION_DAYS", "deleteRule": "created_at-before-cutoff" },
    { "tables": ["security_rate_limits"], "retentionDays": 7, "deleteRule": "updated_at-before-cutoff" },
    { "tables": ["processed_events"], "retentionDays": 30, "env": "PROCESSED_EVENT_RETENTION_DAYS", "deleteRule": "processed_at-before-cutoff" },
    { "tables": ["queue_failures"], "retentionDays": 30, "env": "QUEUE_FAILURE_RETENTION_DAYS", "deleteRule": "closed-or-terminated-before-cutoff-open-kept" },
    { "tables": ["status_publications"], "retentionDays": 7, "env": "STATUS_PUBLICATION_RETENTION_DAYS", "deleteRule": "inactive-publication-before-cutoff" },
    { "tables": ["api_compatibility_hits"], "retentionDays": 400, "env": "API_COMPATIBILITY_HIT_RETENTION_DAYS", "deleteRule": "day-before-cutoff-after-evidence-export" },
    { "tables": ["migration_checkpoints", "migration_anomalies", "legacy_id_map"], "retention": "contract-observation-plus-400-days", "deleteRule": "separate-reviewed-release-only" },
    { "tables": ["notification_template_versions"], "retention": "indefinite", "deleteRule": "none" }
  ]
}
