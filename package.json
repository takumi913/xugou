{
  "name": "xugou",
  "version": "1.3.1",
  "description": "Xugou monitoring system",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && pnpm run dev",
    "dev:backend": "cd backend && pnpm run dev",
    "build:frontend": "cd frontend && pnpm run build",
    "build:backend": "cd backend && pnpm run build",
    "generate": "cd backend && pnpm run db:generate",
    "generate:contracts": "pnpm --dir backend run contracts:generate",
    "types:worker": "wrangler types backend/src/worker-env.d.ts --include-runtime=false --strict-vars=false",
    "types:worker:check": "wrangler types backend/src/worker-env.d.ts --include-runtime=false --strict-vars=false --check",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev:preview": "pnpm run build && cd backend && pnpm run dev",
    "preview": "cd backend && pnpm run dev",
    "lint": "pnpm --dir backend run lint && pnpm --dir frontend run lint",
    "typecheck": "pnpm --dir backend run typecheck && pnpm --dir frontend exec tsc -b --noEmit"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
